# Non-secret Docker settings. Copy to .env.test.
# Backend secrets belong in ../hph-backend/.env.test.
TEST_BIND_ADDRESS=127.0.0.1
TEST_FRONTEND_PORT=8082
TEST_BACKEND_PORT=8083
TEST_FRONTEND_ORIGIN=http://localhost:8082
TEST_SECURE_COOKIES=false

# In-house server: set TEST_BIND_ADDRESS=0.0.0.0 and
# TEST_FRONTEND_ORIGIN=http://YOUR_SERVER_IP:8082 for office-network access.
# These default HPH ports differ from onboarding (5001) and its database (5432).
